<!--! For copyright / license terms, see COPYRIGHT.rst (top level of repository)
      Repository: https://github.com/C3S/collecting_society_web -->
<tal:block metal:use-macro="backend39"
           i18n:domain="collecting_society_web"
           tal:define="royalties context.royalties">

    <!-- content left -->
    <tal:block metal:fill-slot="content-left"></tal:block>

    <!-- content right -->
    <tal:block metal:fill-slot="content-right">

        <h1 class="cs-form-header" i18n:translate="">Royalties</h1>

        <div class="btn-toolbar cs-form-controls" role="toolbar">
            <div class="btn-group" role="group">
                <tal:block tal:condition="request.GET.get('state') != 'finished'">
                    <a tal:condition="request.GET.get('state') != 'finished'"
                       href="${request.resource_path(context, query={'state': 'finished'})}"
                       class="btn btn-default" role="button"
                       i18n:translate="">Archive</a>
                </tal:block>
                <tal:block tal:condition="request.GET.get('state') == 'finished'">
                    <a tal:condition="request.GET.get('state') == 'finished'"
                       href="${request.resource_path(context)}"
                       class="btn btn-default" role="button"
                       i18n:translate="">Open</a>
                </tal:block>
            </div>
        </div>

        <table class="table cs-table cs-table-list">

            <tr tal:condition="not royalties">
                <td class="cs-center">
                    <small i18n:translate=""
                           tal:condition="request.GET.get('state') != 'finished'">
                        No open royalties.
                    </small>
                    <small i18n:translate=""
                           tal:condition="request.GET.get('state') == 'finished'">
                        No archived royalties.
                    </small>
                </td>
            </tr>

            <tr tal:repeat="royalty royalties">

                <td class="cs-img-smallicon">
                    <a tal:condition="royalty.state == 'posted' and royalty.total_amount < 0"
                       href="${request.resource_path(
                               context, royalty.number)}">
                        <span i18n:attributes="title"
                              i18n:domain="collecting_society_web"
                              class="glyphicon glyphicon-exclamation-sign cs-state-icon warning"
                              data-toggle="tooltip"
                              title="Open royalty"
                        ></span>
                    </a>
                    <a tal:condition="royalty.state == 'posted' and royalty.total_amount >= 0"
                       href="${request.resource_path(
                               context, royalty.number)}">
                        <span i18n:attributes="title"
                              i18n:domain="collecting_society_web"
                              class="glyphicon glyphicon-exclamation-sign cs-state-icon"
                              data-toggle="tooltip"
                              title="Open royalty"
                        ></span>
                    </a>
                    <a tal:condition="royalty.state == 'paid'"
                       href="${request.resource_path(
                               context, royalty.number)}">
                        <img class="img-responsive center-block"
                             src="${request.static_path(
                                    'collecting_society_web:'
                                    'static/img/element-icon-royalties-green.svg')}" />
                    </a>
                    <a tal:condition="royalty.state == 'cancelled'"
                       href="${request.resource_path(
                               context, royalty.number)}">
                        <span class="cs-canceled">
                            <img class="img-responsive center-block"
                                 src="${request.static_path(
                                        'collecting_society_web:'
                                        'static/img/element-icon-royalties-green.svg')}" />
                        </span>
                    </a>
                </td>

                <td>
                    <a href="${request.resource_path(context, royalty.number)}">
                        ${royalty.description}
                    </a>
                    <div class="cs-row-subtitle cs-declaration-subtitle">
                        <a href="${request.resource_path(context, royalty.number)}">
                            <b>${royalty.number}</b> -
                            <small>${royalty.invoice_date}</small>
                        </a>
                    </div>
                </td>

                <td>
                    <small tal:switch="royalty.state" tal:condition="royalty.total_amount < 0"
                           class="cs-warning">
                        <a href="${request.resource_path(context, royalty.number)}"
                           tal:case="'posted'" i18n:translate="">
                            Open royalty
                        </a>
                    </small>
                    <small tal:switch="royalty.state" tal:condition="royalty.total_amount >= 0">
                        <a href="${request.resource_path(context, royalty.number)}"
                           tal:case="'posted'" i18n:translate="">
                            Open royalty
                        </a>
                    </small>
                </td>

                <td class="text-right">
                    <a href="${request.resource_path(context, royalty.number)}">
                        ${h.format_currency(royalty.total_amount)}
                    </a>
                </td>

                <td class="text-right cs-action-icon-column">
                    <a href="${request.resource_path(context, royalty.number, 'download')}">
                        <span i18n:attributes="title"
                              i18n:domain="collecting_society_web"
                              class="glyphicon glyphicon-circle-arrow-down cs-download-icon"
                              data-toggle="tooltip"
                              title="Download"
                        ></span>
                    </a>
                </td>

            </tr>
        </table>

    </tal:block>

</tal:block>
