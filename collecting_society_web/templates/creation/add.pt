      Repository: https://github.com/C3S/collecting_society_web -->
<tal:block metal:use-macro="backend39"
           i18n:domain="collecting_society_web">

    <!-- content left -->
    <tal:block metal:fill-slot="content-left"></tal:block>

    <!-- content right -->
    <tal:block metal:fill-slot="content-right">

        <div class="cs-form-container">

            <h1 class="cs-form-header" i18n:translate="">Add Creation</h1>

            <div class="btn-toolbar cs-form-controls" role="toolbar">
                <div class="btn-group" role="group">
                    <a href="${request.resource_path(context)}"
                       class="btn btn-default" role="button"
                       i18n:translate="">Creations</a>
                    <a class="btn btn-primary" role="button"
                       onclick="$('#AddCreationsubmit').click();"
                       i18n:translate="">Submit</a>
                </div>
            </div>

            <div tal:content="structure AddCreation"/>

            <script>
                $(document).ready(function() {
                    // form logic for derivation type
                    var tab = $('#cs-navform-item-content-derivation');
                    var type = tab.find('select#distribution_type');
                    var adaption = tab.find('.item-adaption');
                    var cover = tab.find('.item-cover');
                    var remix = tab.find('.item-remix');
                    type.change(function() {
                        var selected = type.find(":selected").first().val();
                        switch(selected) {
                            case 'adaption':
                                adaption.show();
                                cover.hide();
                                remix.hide();
                                break;
                            case 'cover':
                                adaption.hide();
                                cover.show();
                                remix.hide();
                                break;
                            case 'remix':
                                adaption.hide();
                                cover.hide();
                                remix.show();
                                break;
                            default:
                                adaption.hide();
                                cover.hide();
                                remix.hide();
                        }
                    });
                    type.trigger('change');
                });
            </script>

        </div>

    </tal:block>

</tal:block>
