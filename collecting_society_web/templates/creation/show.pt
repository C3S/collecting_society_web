<!--! For copyright / license terms, see COPYRIGHT.rst (top level of repository)
      Repository: https://github.com/C3S/collecting_society_web -->
<tal:block metal:use-macro="backend363"
           i18n:domain="collecting_society_web"
           tal:define="creation context.creation">

    <!-- content left -->
    <tal:block metal:fill-slot="content-left"></tal:block>

    <!-- content middle -->
    <tal:block metal:fill-slot="content-middle">

        <h1>
            ${creation.title}
            <small>${creation.artist.name}</small>
        </h1>

        <div class="btn-toolbar cs-form-controls" role="toolbar">
            <div class="btn-group" role="group">
                <a href="${request.resource_path(context, '..')}"
                   class="btn btn-default" role="button"
                   i18n:translate="">Creations</a>
                <a href="${request.resource_path(context, 'edit')}"
                   class="btn btn-primary btn-creation-edit" role="button"
                   i18n:translate="">Edit</a>
            </div>
            <div class="btn-group cs-form-controls pull-right" role="group">
                <a href="${request.resource_path(context, 'delete')}"
                   class="btn btn-danger btn-creation-delete" role="button"
                   i18n:translate="">Delete</a>
            </div>
        </div>

        <table class="table cs-table cs-table-show">

            <tr>
                <td colspan="2">
                    <img class="img-responsive center-block cs-defaultpic"
                         src="${request.static_path(
                                'collecting_society_web:'
                                'static/img/element-icon-songs-green.png')}" />
                </td>
            </tr>

            <tr>
                <th i18n:translate="">Title</th>
                <td>${creation.title}</td>
            </tr>

            <tr>
                <th i18n:translate="">C3S ID</th>
                <td>${creation.code}</td>
            </tr>

            <tr>
                <th i18n:translate="">Featured Artist</th>
                <td>
                    <a href="${request.resource_path(
                               context, '..', '..', 'artists',
                               creation.artist.code)}"
                       tal:omit-tag="not creation.artist.permits(
                                         request.web_user, 'view_artist')">
                        ${creation.artist.name}
                    </a>
                </td>
            </tr>

            <tr tal:condition="creation.genres">
                <th i18n:translate="">Genres</th>
                <td>
                    <div tal:repeat="genre creation.genres">
                        ${genre.name}
                    </div>
                </td>
            </tr>

            <tr tal:condition="creation.styles">
                <th i18n:translate="">Styles</th>
                <td>
                    <div tal:repeat="style creation.styles">
                        ${style.name}
                    </div>
                </td>
            </tr>

            <tr tal:condition="copyright">
                <th i18n:translate="">Copyright</th>
                <td>
                    <ul>
                        <li tal:repeat="(rightsholder, rights) copyright.items()">
                            <div>${rightsholder.name}</div>
                            <small class="cs-row-subtitle"
                                   tal:repeat="right rights">
                                <div tal:switch="right.contribution">
                                    <tal:block tal:case="'lyrics'" i18n:translate="">
                                        Lyrics
                                    </tal:block>
                                    <tal:block tal:case="'composition'" i18n:translate="">
                                        Composition
                                    </tal:block>
                                    <span tal:condition="right.collecting_society">
                                        (${right.collecting_society.name})
                                    </span>
                                </div>
                            </small>
                        </li>
                    </ul>
                </td>
            </tr>

            <tr tal:condition="ancillary">
                <th i18n:translate="">Ancillary Copyright</th>
                <td>
                    <ul>
                        <li tal:repeat="(rightsholder, rights) ancillary.items()">
                            <div>${rightsholder.name}</div>
                            <small class="cs-row-subtitle"
                                   tal:repeat="right rights">
                                <div tal:switch="right.contribution">
                                    <tal:block tal:case="'instrument'" i18n:translate="">
                                        Instrument
                                    </tal:block>
                                    <tal:block tal:case="'production'" i18n:translate="">
                                        Production
                                    </tal:block>
                                    <tal:block tal:case="'mixing'" i18n:translate="">
                                        Mixing
                                    </tal:block>
                                    <tal:block tal:case="'mastering'" i18n:translate="">
                                        Mastering
                                    </tal:block>
                                    <span tal:condition="right.collecting_society">
                                        (${right.collecting_society.name})
                                    </span>
                                    <span tal:condition="right.instruments">
                                        - ${", ".join([
                                            instrument.name
                                            for instrument in right.instruments
                                           ])}
                                    </span>
                                </div>
                            </small>
                        </li>
                    </ul>
                </td>
            </tr>

            <tr tal:condition="creation.original_relations">
                <th i18n:translate="">Origins</th>
                <td>
                    <div tal:switch="creation.distribution_type" style="margin-bottom: 5px;">
                        <span tal:case="'original'" i18n:translate="">Original</span>
                        <span tal:case="'adaption'" i18n:translate="">Adaption of</span>
                        <span tal:case="'cover'" i18n:translate="">Cover of</span>
                        <span tal:case="'remix'" i18n:translate="">Remix of</span>
                    </div>
                    <tal:block tal:repeat="original_relation creation.original_relations">
                        <div tal:define="original_creation original_relation.original_creation;
                                         original_artist original_creation.artist"
                             class="cs-list-item">
                            <img class="img-responsive cs-img-inline pull-left"
                                 src="${request.static_path(
                                        'collecting_society_web:'
                                        'static/img/element-icon-songs-green.png')}" />
                            <div>
                                <a tal:attributes="href request.resource_path(
                                                        context, '..', original_creation.code)"
                                   tal:omit-tag="not original_creation.permits(
                                                     request.web_user, 'view_creation')">
                                    ${original_creation.title}
                                </a>
                                <div>
                                    <a tal:attributes="href request.resource_path(
                                                            context, '..', '..',
                                                            'artists', original_artist.code)"
                                       tal:omit-tag="not original_artist.permits(
                                                         request.web_user, 'view_artist')">
                                        <small class="cs-original-artist">
                                            ${original_artist.name}
                                        </small>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </tal:block>
                </td>
            </tr>

            <tr tal:condition="creation.derivative_relations">
                <th i18n:translate="">Derivatives</th>
                <td>
                    <tal:block tal:repeat="derivative_relation creation.derivative_relations">
                        <div tal:define="derivative_creation derivative_relation.derivative_creation;
                                         derivative_artist derivative_creation.artist"
                             class="cs-list-item">
                            <img class="img-responsive cs-img-inline pull-left"
                                 src="${request.static_path(
                                        'collecting_society_web:'
                                        'static/img/element-icon-songs-green.png')}" />
                            <div>
                                <a tal:attributes="href request.resource_path(
                                                        context, '..', derivative_creation.code)"
                                   tal:omit-tag="not derivative_creation.permits(
                                                     request.web_user, 'view_creation')">
                                    ${derivative_creation.title}
                                </a>
                                <small tal:switch="derivative_creation.distribution_type"
                                       class="cs-original">
                                    <span tal:case="'original'" i18n:translate="">Original</span>
                                    <span tal:case="'adaption'" i18n:translate="">Adaption</span>
                                    <span tal:case="'cover'" i18n:translate="">Cover</span>
                                    <span tal:case="'remix'" i18n:translate="">Remix</span>
                                </small>
                                <div>
                                    <a tal:attributes="href request.resource_path(
                                                            context, '..', '..',
                                                            'artists', derivative_artist.code)"
                                       tal:omit-tag="not derivative_artist.permits(
                                                         request.web_user, 'view_artist')">
                                        <small class="cs-original-artist">
                                            ${derivative_artist.name}
                                        </small>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </tal:block>
                </td>
            </tr>

            <tr tal:condition="creation.licenses">
                <th i18n:translate="">Licenses</th>
                <td>
                    <div tal:repeat="license creation.licenses"
                         class="cs-list-item">
                        <a tal:attributes="href license.link">
                           ${license.name} ${license.version}
                           <small>(${license.code})</small>
                        </a>
                    </div>
                </td>
            </tr>

            <tr tal:condition="creation.release">
                <th i18n:translate="">First Release</th>
                <td>
                    <a tal:attributes="href request.resource_path(
                                            context, '..', '..', 'releases',
                                            creation.release.code)"
                        tal:omit-tag="not creation.release.permits(
                                          request.web_user, 'view_release')">
                       ${creation.release.title}
                    </a>
                </td>
            </tr>

            <tr tal:condition="creation.releases">
                <th i18n:translate="">Releases</th>
                <td>
                    <div tal:repeat="release creation.releases"
                         class="cs-list-item">
                        <a tal:attributes="href request.resource_path(
                                                context, '..', '..', 'releases',
                                                release.release.code)"
                           tal:omit-tag="not release.release.permits(
                                             request.web_user, 'view_release')">
                           ${release.release.title}
                        </a>
                    </div>
                </td>
            </tr>

            <tr tal:condition="creation.content">
                <th i18n:translate="">Content</th>
                <td>
                    <div tal:repeat="content creation.content"
                         class="cs-list-item">
                        <img class="img-responsive cs-img-inline"
                             src="${request.static_path(
                                    'collecting_society_web:'
                                    'static/img/element-icon-upload-green.png')}"/>
                        ${content.name}
                        <audio controls tal:condition="content.category == 'audio'"
                               style="margin-top: 5px;">
                            <source type="audio/ogg"
                                    tal:attributes="src request.resource_path(
                                                        request.root, 'repertoire', 'files',
                                                        content.code, 'preview')">
                        </audio>
                    </div>
                </td>
            </tr>

            <tr tal:condition="creation.tariff_categories">
                <th i18n:translate="">Tariff Categories</th>
                <td>
                    <div tal:repeat="ctc creation.tariff_categories"
                         class="cs-list-item">
                        ${ctc.category.name}<br>
                        <small class="cs-collecting-society">
                            ${ctc.collecting_society.name}
                        </small>
                    </div>
                </td>
            </tr>

            <tr tal:condition="creation.lyrics">
                <th i18n:translate="">Lyrics</th>
                <td>
                    <pre style="font-size: 12px; white-space: break-spaces;"
                        >${creation.lyrics}</pre>
                </td>
            </tr>

        </table>

    </tal:block>

    <!-- content right -->
    <tal:block metal:fill-slot="content-right"></tal:block>

</tal:block>
