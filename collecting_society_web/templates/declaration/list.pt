<!--! For copyright / license terms, see COPYRIGHT.rst (top level of repository)
      Repository: https://github.com/C3S/collecting_society_web -->
<tal:block metal:use-macro="backend39"
           i18n:domain="collecting_society_web"
           tal:define="declarations context.declarations">

    <!-- content left -->
    <tal:block metal:fill-slot="content-left"></tal:block>

    <!-- content right -->
    <tal:block metal:fill-slot="content-right">

        <h1 class="cs-form-header" i18n:translate="">Declarations</h1>

        <div class="btn-toolbar cs-form-controls" role="toolbar">
            <div class="btn-group" role="group">
                <a href="${request.resource_path(context, 'add')}"
                   class="btn btn-primary" role="button"
                   i18n:translate="">Add</a>
                <a tal:condition="request.GET.get('state') != 'finished'"
                   href="${request.resource_path(context, query={'state': 'finished'})}"
                   class="btn btn-default" role="button"
                   i18n:translate="">Archive</a>
                <a tal:condition="request.GET.get('state') == 'finished'"
                   href="${request.resource_path(context)}"
                   class="btn btn-default" role="button"
                   i18n:translate="">Open</a>
            </div>
        </div>

        <table class="table cs-table cs-table-list">

            <tr tal:repeat="declaration declarations">

                <td class="cs-img-smallicon">
                    <a tal:condition="not declaration.next_step"
                       href="${request.resource_path(
                               context, declaration.code)}">
                        <img class="img-responsive center-block"
                             src="${request.static_path(
                                    'collecting_society_web:'
                                    'static/img/element-icon-declarations-yellow.svg')}" />
                    </a>
                    <a tal:condition="declaration.next_step == 'utilisation'"
                       href="${request.resource_path(
                               context, declaration.code)}">
                        <span i18n:attributes="title"
                              i18n:domain="collecting_society_web"
                              class="glyphicon glyphicon-time cs-state-icon"
                              data-toggle="tooltip"
                              title="Waiting for the end of the utilisation"
                        ></span>
                    </a>
                    <a tal:condition="declaration.next_step == 'estimation'"
                       href="${request.resource_path(
                               context, declaration.code)}">
                        <span i18n:attributes="title"
                              i18n:domain="collecting_society_web"
                              class="glyphicon glyphicon-exclamation-sign cs-state-icon warning"
                              data-toggle="tooltip"
                              title="Please estimate the utilisation"
                        ></span>
                    </a>
                    <a tal:condition="declaration.next_step == 'confirmation'"
                       href="${request.resource_path(
                               context, declaration.code, 'confirm')}">
                        <span i18n:attributes="title"
                              i18n:domain="collecting_society_web"
                              class="glyphicon glyphicon-exclamation-sign cs-state-icon warning"
                              data-toggle="tooltip"
                              title="Please confirm the utilisation"
                        ></span>
                    </a>
                    <a tal:condition="declaration.next_step == 'finalization'"
                       href="${request.resource_path(
                               context, declaration.code, 'finalize')}">
                        <span i18n:attributes="title"
                              i18n:domain="collecting_society_web"
                              class="glyphicon glyphicon-exclamation-sign cs-state-icon warning"
                              data-toggle="tooltip"
                              title="Please finalize the utilisation"
                        ></span>
                    </a>
                    <a tal:condition="declaration.next_step == 'processing'"
                       href="${request.resource_path(
                               context, declaration.code)}">
                        <span i18n:attributes="title"
                              i18n:domain="collecting_society_web"
                              class="glyphicon glyphicon-time cs-state-icon"
                              data-toggle="tooltip"
                              title="Please wait until the declaration is processed"
                        ></span>
                    </a>
                    <a tal:condition="declaration.next_step == 'payment'"
                       href="${request.resource_path(
                               context, declaration.code)}">
                        <span i18n:attributes="title"
                              i18n:domain="collecting_society_web"
                              class="glyphicon glyphicon-exclamation-sign cs-state-icon warning"
                              data-toggle="tooltip"
                              title="Please pay the bill"
                        ></span>
                    </a>
                </td>

                <td>
                    <a href="${request.resource_path(
                               context, declaration.code)}"
                       class="cs-declaration-title">
                        ${declaration.context.name}
                    </a>
                    <div class="cs-row-subtitle cs-declaration-subtitle">
                        <a tal:attributes="href request.resource_path(
                                                context, declaration.code)">
                            <b><small>${declaration.tariff.category.name}</small></b>
                            <small tal:condition="declaration.period == 'onetime'">
                                <tal:block tal:condition="declaration.tariff.category.code == 'L'">
                                    ${declaration.context.start.date()}
                                </tal:block>
                                <tal:block tal:condition="declaration.tariff.category.code != 'L'">
                                    ${declaration.creation_time.date()}
                                </tal:block>
                            </small>
                            <small tal:condition="declaration.period != 'onetime'">
                                ${declaration.period.capitalize()}
                            </small>
                        </a>
                    </div>
                </td>

                <td>
                    <small tal:switch="declaration.next_step"
                           class="cs-warning">
                        <a href="${request.resource_path(context, declaration.code)}"
                           tal:case="'estimation'" i18n:translate="">
                            Please estimate your utilisation
                        </a>
                        <a href="${request.resource_path(context, declaration.code, 'confirm')}"
                           tal:case="'confirmation'" i18n:translate="">
                            Please confirm your utilisation
                        </a>
                        <a href="${request.resource_path(context, declaration.code, 'finalize')}"
                           tal:case="'finalization'" i18n:translate="">
                            Please finalize your utilisation
                        </a>
                        <a href="${request.resource_path(context, declaration.code)}"
                           tal:case="'payment'" i18n:translate="">
                            Please pay your invoice
                        </a>
                    </small>
                </td>

                <td class="text-right cs-table-codecolumn">
                    <a href="${request.resource_path(
                               context, declaration.code)}"
                       class="cs-declaration-title">
                        <div>${declaration.code}</div>
                    </a>
                </td>

            </tr>

        </table>

    </tal:block>

</tal:block>
