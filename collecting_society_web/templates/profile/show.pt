      Repository: https://github.com/C3S/collecting_society_web -->
<tal:block metal:use-macro="backend363"
           i18n:domain="collecting_society_web">

    <!-- content middle -->
    <tal:block metal:fill-slot="content-middle"
               tal:define="web_user request.web_user;
                           party request.party">

        <h1 i18n:translate="">Profile</h1>

        <div class="btn-toolbar cs-form-controls" role="toolbar">
            <div class="btn-group" role="group">
                <a href="${request.resource_path(context, 'edit')}"
                   class="btn btn-primary" role="button"
                   i18n:translate="">Edit</a>
            </div>
        </div>

        <div class="table cs-table cs-table-show">
            <table class="table table-hover">

                <tr>
                    <th i18n:translate="">Firstname</th>
                    <td>${party.firstname or ""}</td>
                </tr>

                <tr>
                    <th i18n:translate="">Lastname</th>
                    <td>${party.lastname or ""}</td>
                </tr>

                <tr>
                    <th i18n:translate="">Email</th>
                    <td>${web_user.email or ""}</td>
                </tr>

                <tr>
                    <th i18n:translate="">Birthdate</th>
                    <td>${party.birthdate.strftime("%d.%m.%Y") or ""}</td>
                </tr>

                <tr tal:condition="party.addresses"
                    tal:define="address party.addresses and party.addresses[0]">
                    <th i18n:translate="">Address</th>
                    <td>
                        <div>${address.street}</div>
                        <div>${address.postal_code} ${address.city}</div>
                        <div>${address.country.name}</div>
                    </td>
                </tr>

                <tr>
                    <th i18n:translate="">Default Role</th>
                    <td tal:switch="web_user.default_role">
                        <span tal:case="'licenser'" i18n:translate="">Licenser</span>
                        <span tal:case="'licensee'" i18n:translate="">Licensee</span>
                    </td>
                </tr>

                <tr>
                    <th i18n:translate="">Rights</th>
                    <td>
                        <div>
                            <span i18n:translate="">Creations</span>:
                            ${len(party.creation_rights)}
                        </div>
                        <div>
                            <span i18n:translate="">Releases</span>:
                            ${len(party.release_rights)}
                        </div>
                    </td>
                </tr>

                <tr>
                    <th i18n:translate="">Created</th>
                    <td>${web_user.create_date.strftime("%d.%m.%Y") or ""}</td>
                </tr>

            </table>
        </div>

    </tal:block>

</tal:block>
