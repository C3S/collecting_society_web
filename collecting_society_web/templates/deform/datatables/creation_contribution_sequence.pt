<tal:block metal:extend-macro="sequence"
           i18n:domain="collecting_society_web">

    <script metal:fill-slot="settings">
        var datatableSequenceSettings = {
            columns: [
                {
                    name: "rightsholder",
                    title: "${_('Rightsholder')}",
                    data: "rightsholder",
                    className: "always",
                    orderable: true,
                    searchable: false,
                    render: function(data, type, row, meta) {
                        if(type !== 'display' && type !== 'sort')
                            return data;
                        if(data.datatableSequence !== true)
                            return "";
                        var subdata = data.target.table.rows().data()
                        return tmpl.encode(subdata[0].name);
                    },
                    defaultContent: "",
                    datatableSequence: {
                        position: "displayed",
                        widgetType: 'DatatableSequenceWidget',
                    },
                },
                {
                    name: "rights",
                    title: "${_('Rights')}",
                    data: "rights",
                    className: "always",
                    orderable: false,
                    searchable: false,
                    render: function(data, type, row, meta) {
                        if(type !== 'display' && type !== 'sort')
                            return data;
                        if(data.datatableSequence !== true)
                            return "";
                        var subdata = data.target.table.rows().data();
                        var content = '<ul>';
                        $.each(subdata, function(index, row) {
                            content += '<li><b>' + tmpl.encode(row.contribution) + '</b>';
                            if (!!row.collecting_society)
                                content += '<small>' +
                                             ' - ' + tmpl.encode(row.collecting_society) +
                                           '</small>';
                            var contribution = $(row.sequence)
                                .find('.item-contribution option:selected')
                                .val();
                            if (contribution === 'ancillary-instrument')
                                content += '<small style="display: block; font-style: italic;">' +
                                              tmpl.encode(row.instruments) +
                                           '</small>';
                            content += '</li>';
                        });
                        content += '</ul>';
                        return content;
                    },
                    defaultContent: "",
                    datatableSequence: {
                        position: "displayed",
                        widgetType: 'DatatableSequenceWidget',
                    },
                },
            ],
        };
    </script>

</tal:block>
