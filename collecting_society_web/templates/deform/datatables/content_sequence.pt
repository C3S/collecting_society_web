<tal:block metal:extend-macro="sequence"
           i18n:domain="collecting_society_web">

    <script metal:fill-slot="settings">
        var datatableSequenceSettings = {
            apiPath: "content",
            apiArgs: function(args) {
                args.category = "${field.schema.category}";
            },
            unique: "code",
            columns: [
                {
                    name: "name",
                    title: "${_('Name')}",
                    data: "name",
                    className: "all",
                    orderable: true,
                    searchable: true,
                    render: $.fn.dataTable.render.text(),
                    datatableSequence: {
                        position: "displayed",
                        widgetType: 'TextInputWidget',
                        footerSearch: true,
                        createShow: true,
                    },
                },
                {
                    name: "code",
                    title: "${_('Code')}",
                    data: "code",
                    orderable: true,
                    searchable: true,
                    render: $.fn.dataTable.render.text(),
                    datatableSequence: {
                        position: "displayed",
                        widgetType: 'HiddenWidget',
                        footerSearch: true,
                    },
                },
                {
                    name: "preview",
                    title: "${_('Preview')}",
                    data: "preview",
                    orderable: false,
                    searchable: false,
                    render: function(data, type, row, meta) {
                        if(type !== 'display' && type !== 'sort')
                            return data;
                        if (!JSON.parse(data))
                            return "";
                        var src = "/repertoire/files/" + row['code'] + "/preview"
                        if (row['category'] === 'audio')
                            return "<audio controls>" +
                                "<source type='audio/ogg' src='" + src + "'>" +
                            "</audio>";
                        return "";
                    },
                    datatableSequence: {
                        position: "displayed",
                        widgetType: 'HiddenWidget',
                    },
                },
            ],
        };
    </script>

</tal:block>
