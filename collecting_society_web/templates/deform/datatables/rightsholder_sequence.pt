<tal:block metal:extend-macro="sequence"
           i18n:domain="collecting_society_web">

    <script metal:fill-slot="settings">
        var datatableSequenceSettings = {
            apiPath: "rightsholder",
            columns: [
                {
                    name: "name",
                    title: "${_('Name')}",
                    data: "name",
                    className: "all",
                    orderable: true,
                    searchable: true,
                    render: function(data, type, row, meta) {
                        if(type !== 'display' && type !== 'sort')
                            return data;
                        if(row.mode != 'add')
                            return tmpl.encode(row.name) + "<br>" +
                                   "<small>" + tmpl.encode(row.email) + "</small>";
                        return tmpl.encode(data);
                    },
                    datatableSequence: {
                        position: "displayed",
                        widgetType: 'TextInputWidget',
                        footerSearch: true,
                        createShow: true,
                    }
                },
                {
                    name: "email",
                    title: "${_('Email')}",
                    data: "email",
                    visible: false,
                    orderable: false,
                    searchable: false,
                    defaultContent: "",
                    render: $.fn.dataTable.render.text(),
                    datatableSequence: {
                        position: "invisible",
                        widgetType: 'TextInputWidget',
                        createShow: true,
                    }
                },
            ],
        };
    </script>

</tal:block>
