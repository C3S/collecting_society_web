<tal:block metal:extend-macro="sequence"
           i18n:domain="collecting_society_web">

    <script metal:fill-slot="settings">
        var datatableSequenceSettings = {
            apiPath: "creation",
            unique: "code",
            columns: [
                {
                    name: "titlefield",
                    title: "${_('Title')}",
                    data: "titlefield",
                    className: "all",
                    orderable: true,
                    searchable: true,
                    render: function(data, type, row, meta) {
                        if(type !== 'display' && type !== 'sort')
                            return data;
                        if (row.othertitles == "")
                            return tmpl.encode(data);
                        var title = tmpl.encode(row.othertitles);
                        return "<span data-toggle='tooltip' title='" + title + "'>" +
                            tmpl.encode(data) +
                        "</span>";
                    },
                    datatableSequence: {
                        position: "displayed",
                        widgetType: 'TextInputWidget',
                        footerSearch: true,
                        createShow: true,
                    }
                },
                {
                    name: "artist",
                    title: "${_('Artist')}",
                    data: "artist",
                    className: "all",
                    orderable: true,
                    searchable: true,
                    render: $.fn.dataTable.render.text(),
                    datatableSequence: {
                        position: "displayed",
                        widgetType: 'TextInputWidget',
                        footerSearch: true,
                        createShow: true,
                    }
                },
                {
                    name: "code",
                    title: "${_('Code')}",
                    data: "code",
                    orderable: true,
                    searchable: true,
                    render: $.fn.dataTable.render.text(),
                    datatableSequence: {
                        position: "displayed",
                        widgetType: 'HiddenWidget',
                        footerSearch: true,
                    }
                },
                {
                    name: "othertitles",
                    title: "${_('Other Titles')}",
                    data: "othertitles",
                    visible: false,
                    orderable: false,
                    searchable: false,
                    render: $.fn.dataTable.render.text(),
                    datatableSequence: {
                        position: "invisible",
                        widgetType: 'HiddenWidget',
                    }
                },
            ],
        };
    </script>

</tal:block>
